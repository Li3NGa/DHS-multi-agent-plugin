{
  "name": "dsh-multi-agent-orchestration",
  "version": "0.2.0",
  "description": "DSH native multi-agent orchestration runtime: Task, TaskGraph, Scheduler, Sequential, Relay, Broadcast over ctx.agents",
  "type": "module",
  "main": "./dist/dsh.bundle.js",
  "exports": {
    ".": "./dist/dsh.bundle.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/dsh.bundle.js --sourcemap --external:@deepseek-ai/*",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
