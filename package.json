{
  "name": "dhs-multi-agent",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness multi-agent Cordis plugin",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "pnpm --dir packages/dsh-multi-agent test",
    "typecheck": "pnpm --dir packages/dsh-multi-agent typecheck",
    "build": "esbuild packages/dsh-multi-agent/src/index.ts --bundle --format=esm --outfile=dist/index.js --sourcemap --external:@deepseek-ai/*",
    "prepare": "pnpm run build",
    "test:smoke": "pnpm run build && pnpm --dir packages/dsh-multi-agent run test:smoke"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
