{
  "name": "dhs-multi-agent",
  "version": "0.2.0",
  "description": "Native DeepSeek Harness multi-agent Cordis plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "pnpm --dir packages/dsh-multi-agent test",
    "typecheck": "pnpm --dir packages/dsh-multi-agent typecheck",
    "build:js": "esbuild packages/dsh-multi-agent/src/index.ts --bundle --format=esm --outfile=dist/index.js --sourcemap --external:@deepseek-ai/*",
    "build:types": "pnpm --dir packages/dsh-multi-agent exec tsc -p tsconfig.build.json && node scripts/patch-native-declarations.mjs",
    "build": "pnpm run build:js && pnpm run build:types",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "test:smoke": "pnpm run build && pnpm --dir packages/dsh-multi-agent run test:smoke",
    "release:check": "node scripts/check-npm-release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Li3NGa/DHS-multi-agent-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Li3NGa/DHS-multi-agent-plugin/issues"
  },
  "homepage": "https://github.com/Li3NGa/DHS-multi-agent-plugin#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "multi-agent",
    "orchestration",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
