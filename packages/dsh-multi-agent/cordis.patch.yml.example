# dsh-multi-agent native plugin 的 cordis.patch.yml 示例条目。
#
# 注意（PARTIALLY VERIFIED）：本机的验证覆盖「真实 DSH 运行时加载
# dist/dsh.bundle.js」（cordis + dsh-* 服务，见 smoke/dsh.bundle.spec.ts）；
# 完整桌面/TUI 的 patch.yml 解析与 $bundle 装载路径未在本机验证
# （无 ~/.dsh 桌面安装）。合并进 profile 后请按 README 冒烟一遍。
#
# bundle 的 @deepseek-ai/* 依赖是 external：由 DSH 宿主运行时提供，
# 不要把 DSH 自身的包打进 bundle。

plugins:
  dsh-multi-agent:
    $path: <repo>/dsh-native/dist/dsh.bundle.js
    # 可选配置
    # concurrency: 8          # scheduler 默认并发上限
    # defaultTimeoutMs: 60000 # 单任务默认超时（默认 60s）
